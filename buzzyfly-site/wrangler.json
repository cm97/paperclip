{
	"$schema": "https://unpkg.com/wrangler@4/config-schema.json",
	"name": "buzzyfly-paperclip",
	"main": "./src/index.ts",
	"compatibility_date": "2026-09-01",
	"observability": { "enabled": true },
	"assets": {
		"directory": "./public",
		"binding": "ASSETS"
	},
	"routes": [
		{ "pattern": "paperclip.buzzyfly.com", "custom_domain": true }
	]
}
